# =============================================================================
# Roamly — environment variables
# Copy this file to `.env.local` and fill in the keys you have.
# The app falls back to mock/catalog data when a provider is not configured.
# =============================================================================

# --- Google Gemini (required for live multi-agent planning) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Supabase (auth + persistence). If either is empty, UI uses mock data. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for schema-safe writes from API routes. Optional if RLS + user JWT is enough.
SUPABASE_SERVICE_ROLE_KEY=

# --- Default origin when the user does not specify a departure city ---
DEFAULT_ORIGIN_CITY=Mumbai
DEFAULT_ORIGIN_IATA=BOM
DEFAULT_ORIGIN_LAT=19.0896
DEFAULT_ORIGIN_LNG=72.8656

# --- Flight search (Duffel). Review later. ---
DUFFEL_API_KEY=
DUFFEL_API_URL=https://api.duffel.com

# --- Hotels (Expedia Rapid). Review later. ---
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_API_SECRET=
EXPEDIA_RAPID_API_URL=

# --- Activities (Viator / GetYourGuide). Review later. ---
VIATOR_API_KEY=
GETYOURGUIDE_API_KEY=

# --- Maps / transit (Google Maps Distance Matrix + Places). Review later. ---
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional web search for neighborhood grounding (Tavily) ---
TAVILY_API_KEY=
