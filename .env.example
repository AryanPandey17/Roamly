# =============================================================================
# Roamly — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Keep secrets off it.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The older name NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Bypasses RLS. Used for logs, quota counters and cache tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only. Postgres connection string: dashboard → Connect → Session pooler.
# Used by `npm run db:migrate`, `npm run db:types` and the LangGraph checkpointer.
SUPABASE_DB_URL=postgresql://postgres:your-password@your-host:5432/postgres

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM tier 1: OpenRouter (free models) ------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# --- LLM tier 2: NVIDIA hosted endpoint (free prototyping) -------------------
# https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-key

# --- Defaults when the user gives no origin or currency ----------------------
DEFAULT_ORIGIN_CITY=Mumbai
DEFAULT_CURRENCY=INR

# --- Travel / maps APIs ------------------------------------------------------
# Added in Phase 5 once providers are chosen (see docs/api_research.md).
