# =============================================================================
# Roamly — environment variables
# Copy to `.env` and fill in. Never commit `.env`.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Keep secrets off it.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The older name NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Server-only. Bypasses RLS. Used for logs, quota counters and cache tables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only. Postgres connection string: dashboard → Connect → Session pooler.
# Used by `npm run db:migrate`, `npm run db:types` and the LangGraph checkpointer.
SUPABASE_DB_URL=postgresql://postgres:your-password@your-host:5432/postgres

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM tier 1: OpenRouter (free models) ------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# --- LLM tier 2: NVIDIA hosted endpoint (free prototyping) -------------------
# https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-key

# --- Defaults when the user gives no origin or currency ----------------------
DEFAULT_ORIGIN_CITY=Mumbai
DEFAULT_CURRENCY=INR

# --- Travel data (all free plans) --------------------------------------------
# Flights and hotels: https://serpapi.com (250 searches a month)
SERPAPI_API_KEY=your-serpapi-key
# Places and travel times: https://www.geoapify.com (3,000 credits a day)
GEOAPIFY_API_KEY=your-geoapify-key
# Web search for cost estimates: https://tavily.com (1,000 credits a month)
TAVILY_API_KEY=your-tavily-key
# Geocoding, weather (Open-Meteo) and currency rates (Frankfurter) need no key.

# --- Map tiles (optional) ----------------------------------------------------
# Defaults to OpenStreetMap's standard tiles, which are fine for local use.
# Set this to a keyed provider's URL template to switch.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
