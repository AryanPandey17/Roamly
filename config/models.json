{
  "providers": {
    "openrouter": {
      "baseURL": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "requestsPerMinute": 15,
      "dailyLimit": 50
    },
    "nvidia": {
      "baseURL": "https://integrate.api.nvidia.com/v1",
      "apiKeyEnv": "NVIDIA_API_KEY",
      "requestsPerMinute": 20,
      "dailyLimit": null
    }
  },
  "roles": {
    "reasoning": [
      {
        "provider": "openrouter",
        "models": [
          "nvidia/nemotron-3-super-120b-a12b:free",
          "qwen/qwen3.8-27b:free",
          "google/gemma-4-31b-it:free"
        ]
      },
      { "provider": "nvidia", "models": ["nvidia/nemotron-3-ultra-550b-a55b"], "thinking": true }
    ],
    "worker": [
      {
        "provider": "openrouter",
        "models": [
          "qwen/qwen3.8-27b:free",
          "google/gemma-4-31b-it:free",
          "nvidia/nemotron-3-super-120b-a12b:free"
        ]
      },
      { "provider": "nvidia", "models": ["nvidia/nemotron-3-ultra-550b-a55b"], "thinking": false }
    ],
    "fast": [
      {
        "provider": "openrouter",
        "models": ["google/gemma-4-26b-a4b-it:free", "liquid/lfm-2.5-2.6b:free"]
      },
      { "provider": "nvidia", "models": ["nvidia/nemotron-3-ultra-550b-a55b"], "thinking": false }
    ]
  }
}
